// 1. Заголовки
<h1>Главный заголовок</h1>    {/* Самый важный */}
<h2>Второстепенный</h2>       {/* Менее важный */}
<h3>Маленький заголовок</h3>  {/* Самый маленький */}

// 2. Параграфы
<p>Это обычный текст</p>

// 3. Ссылки
<a href="https://site.com">Текст ссылки</a>

// 4. Изображения
<img src="./image.png" alt="Описание" />

// 5. Кнопки
<button>Нажми меня</button>

// 6. Списки
<ul>                          {/* Маркированный список */}
  <li>Пункт 1</li>
  <li>Пункт 2</li>
</ul>

<ol>                          {/* Нумерованный список */}
  <li>Первый пункт</li>
  <li>Второй пункт</li>
</ol>

